<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Track Your Order - Shop with ease</title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    .timeline { margin: 2rem 0; text-align: left; }
    .step { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.2rem; }
    .circle { width: 36px; height: 36px; border-radius: 50%; background: #dee2e6; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.95rem; flex-shrink: 0; }
    .circle.active { background: #ff6b35; animation: pulse 1.5s infinite; }
    .circle.done { background: #28a745; }
    @keyframes pulse {
      0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 107, 53, 0.4); }
      70% { transform: scale(1.08); box-shadow: 0 0 0 8px rgba(255, 107, 53, 0); }
      100% { transform: scale(1); }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/" class="navbar-brand">🛍️ Shop with <span>ease</span></a>
    <ul class="navbar-links">
      <li><a href="/">Home</a></li>
      <li><a href="/track">Track Order 📦</a></li>
      <li><a href="/cart">Cart 🛒</a></li>
    </ul>
  </nav>

  <div class="page-container" style="max-width: 600px; margin-top: 3rem;">
    <div style="background: #fff; padding: 2.5rem 2rem; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.06); text-align: center;">
      <h2>📦 Track Your Delivery Progress</h2>
      <p style="color: #6c757d; margin: 0.5rem 0 1.5rem;">Enter your Order Reference Code (from your SMS / Receipt):</p>

      <form id="trackForm" style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
        <input type="text" id="orderRef" placeholder="e.g. jwj3lm0yky" required style="flex:1; padding: 0.8rem; border: 1.5px solid #dee2e6; border-radius: 6px; font-size: 1rem;">
        <button type="submit" class="btn" style="width: auto; padding: 0.8rem 1.5rem; margin: 0; background: #0a7e8c;">Track</button>
      </form>

      <div id="resultBox" style="display: none; margin-top: 2rem; text-align: left; background: #f8f9fa; padding: 1.5rem; border-radius: 8px; border: 1px solid #e9ecef;">
        <h3 id="displayStatus" style="color: #0a7e8c; margin-bottom: 0.5rem;"></h3>
        <div id="displayDetails" style="font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.5rem;"></div>

        <!-- Live Step Timeline -->
        <div class="timeline">
          <div class="step">
            <div class="circle done" id="step1">✓</div>
            <div><strong>1. Order Confirmed & Paid</strong></div>
          </div>
          <div class="step">
            <div class="circle" id="step2">2</div>
            <div><strong>2. Packaging & Processing</strong></div>
          </div>
          <div class="step">
            <div class="circle" id="step3">3</div>
            <div><strong>3. Out for Delivery (Rider Dispatched)</strong></div>
          </div>
          <div class="step">
            <div class="circle" id="step4">4</div>
            <div><strong>4. Delivered</strong></div>
          </div>
        </div>

        <a id="waContact" href="#" target="_blank" class="btn" style="background:#25D366; display:block; text-align:center; text-decoration:none; margin-top:1rem; padding: 0.8rem;">
          💬 Chat with Us on WhatsApp
        </a>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('trackForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const ref = document.getElementById('orderRef').value.trim();
      const resultBox = document.getElementById('resultBox');
      const displayStatus = document.getElementById('displayStatus');
      const displayDetails = document.getElementById('displayDetails');

      displayStatus.textContent = 'Searching for order...';
      displayDetails.innerHTML = '';
      resultBox.style.display = 'block';

      try {
        const res = await fetch('/api/orders/' + ref);
        const data = await res.json();

        if (data.success) {
          const o = data.order;
          displayStatus.textContent = 'Status: ' + (o.status || 'Processing');
          displayDetails.innerHTML = `
            <strong>Order Code:</strong> ${o.reference}<br>
            <strong>Customer:</strong> ${o.customerName || 'Customer'}<br>
            <strong>Items:</strong> ${o.items || 'Store Items'}<br>
            <strong>Delivery Address:</strong> ${o.address || 'Accra, Ghana'}<br>
            <strong>Amount:</strong> GH₵${Number(o.amount).toFixed(2)}
          `;

          // Reset step circles
          ['step1', 'step2', 'step3', 'step4'].forEach(id => {
            document.getElementById(id).className = 'circle';
          });

          // Update timeline based on Live Status
          document.getElementById('step1').className = 'circle done';
          const st = o.status || 'Packaging';
          if (st === 'Packaging') {
            document.getElementById('step2').className = 'circle active';
          } else if (st === 'Out for Delivery') {
            document.getElementById('step2').className = 'circle done';
            document.getElementById('step3').className = 'circle active';
          } else if (st === 'Delivered') {
            document.getElementById('step2').className = 'circle done';
            document.getElementById('step3').className = 'circle done';
            document.getElementById('step4').className = 'circle done';
          }

          document.getElementById('waContact').href = `https://wa.me/233536473017?text=${encodeURIComponent('Hi, checking order: ' + o.reference)}`;
        } else {
          displayStatus.textContent = '❌ Order Not Found';
          displayDetails.innerHTML = 'Please check your reference code and try again.';
        }
      } catch (err) {
        displayStatus.textContent = '❌ Connection Error';
        displayDetails.innerHTML = 'Unable to check status. Try again later.';
      }
    });

    // Auto-search if reference is in URL (e.g. /track?ref=jwj3lm0yky)
    const urlRef = new URLSearchParams(window.location.search).get('ref');
    if (urlRef) {
      document.getElementById('orderRef').value = urlRef;
      document.getElementById('trackForm').dispatchEvent(new Event('submit'));
    }
  </script>
</body>
</html>
